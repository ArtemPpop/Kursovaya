<UserControl x:Class="Kursovaya.View.PediaPlayerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kursovaya.View"
             xmlns:utils="clr-namespace:Kursovaya.Utills"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Видео -->
        <MediaElement x:Name="mediaPlayer"
                      Grid.Row="0"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      Stretch="Uniform" />

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="10">
            <!-- Ползунок времени -->
            <Slider x:Name="positionSlider"
        Minimum="0" Maximum="100" Value="0"
        Style="{StaticResource DarkSliderStyle}"
        PreviewMouseUp="PositionSlider_PreviewMouseUp"
        Margin="0,0,0,5" />

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <utils:Btn Content="Play" Width="80" Click="Play_Click"/>
                <utils:Btn Content="Pause" Width="80" Click="Pause_Click"/>

            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>