<UserControl x:Class="Kursovaya.View.FilmListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kursovaya.View"
             mc:Ignorable="d" Height="Auto" Width="Auto">
    <Border Background="#1f1f1f" Padding="10">
    <StackPanel Orientation="Horizontal" Background="#1f1f1f" >
        <TextBlock Text="КиноТека" FontSize="24" FontWeight="Bold" Foreground="White"/>
        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
            <Button Content="Фильмы" Margin="5" Padding="10,5" x:Name="BtnFilms"/>
            <Button Content="Сериалы" Margin="5" Padding="10,5" x:Name="BtnSeries"/>
            <Button Content="Мой профиль" Margin="5" Padding="10,5" x:Name="BtnProfile"/>
            <Button Content="Подписка" Margin="5" Padding="10,5"/>
        </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Width="200" Height="30" Margin="20,0,0,0" VerticalAlignment="Center"
                 />
                <!-- Иконка профиля -->
                <Ellipse Width="30" Height="30" Fill="#555" Margin="10,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>