<UserControl x:Class="Kursovaya.View.RecommendationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kursovaya"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#121212">
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Рекомендации для вас" 
                       FontSize="20" 
                       Foreground="White" 
                       Margin="0,0,0,20"/>

            <!-- Персонализированные рекомендации -->
            <TextBlock Text="На основе ваших предпочтений" 
                       Foreground="#aaa" 
                       Margin="0,0,0,10"/>

            <ItemsControl x:Name="PersonalRecommendations">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="180" Height="300" Background="#1f1f1f" 
                                Margin="10" CornerRadius="5" Cursor="Hand">
                            <!-- Такая же карточка как в FilmsPage -->
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Популярные сейчас -->
            <TextBlock Text="Популярные сейчас" 
                       Foreground="#aaa" 
                       Margin="0,20,0,10"/>

            <ItemsControl x:Name="PopularNow">
                <!-- Аналогичная структура -->
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>