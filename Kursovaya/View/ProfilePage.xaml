<UserControl x:Class="Kursovaya.View.ProfilePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Kursovaya"
             xmlns:utils="clr-namespace:Kursovaya.Utills"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#121212">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Аватар и основная информация -->
        <StackPanel Grid.Column="0" Width="200" Margin="0,0,30,0">
            <Ellipse Width="150" Height="150" Fill="#555" Margin="0,0,0,20"/>
            <TextBlock Text="Имя пользователя" 
                       Foreground="White" 
                       FontSize="18"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="email@example.com" 
                       Foreground="#aaa" 
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,20"/>

            <utils:Btn Content="Редактировать профиль" 
                    Padding="10,5"
                    Background="#333"
                    Foreground="White"/>

            <utils:Btn Content="Добавление" 
                
                    Margin="0 20 0 0"
                    Background="#333"
                    Foreground="White" Width="174"/>

            <utils:Btn Content="Удаление" 
                   
                    Margin="0 20 0 0"
                    Background="#333"
                    Foreground="White" Width="175"/>

            <utils:Btn Content="Редактирование" 
               
                    Margin="0 20 0 0"
                    Background="#333"
                    Foreground="White" Width="173"/>
        </StackPanel>

        <!-- История просмотров -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="История просмотров" 
                       FontSize="18" 
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <ItemsControl x:Name="WatchHistory">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="120" Height="180" Background="#1f1f1f" 
                                Margin="5" CornerRadius="3">
                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Избранное -->
            <TextBlock Text="Избранное" 
                       FontSize="18" 
                       Foreground="White"
                       Margin="0,30,0,15"/>

            <ItemsControl x:Name="Favorites">
                <!-- Аналогичная структура -->
            </ItemsControl>
        </StackPanel>
    </Grid>
</UserControl>